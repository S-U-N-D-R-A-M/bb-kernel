# 0 "arch/arm/boot/dts/ti/omap/BB-EHRPWM2-P8_13-P8_19.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm/boot/dts/ti/omap/BB-EHRPWM2-P8_13-P8_19.dtso"





/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 1
# 9 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/omap.h" 1
# 10 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 2
# 10 "arch/arm/boot/dts/ti/omap/BB-EHRPWM2-P8_13-P8_19.dtso" 2




&{/chosen} {
 overlays {
  BB-EHRPWM2-P8_13-P8_19.kernel = "Tue Jun 16 11:21:58 2026";
 };
};

&am33xx_pinmux {
 epwmss2_pins: pinmux_epwmss2_pins {
  pinctrl-single,pins = <
   ((((0x824)) & 0xffff) - (0x0800)) (((1 << 3))) (4)
   ((((0x820)) & 0xffff) - (0x0800)) (((1 << 3))) (4)
  >;
 };
};

&epwmss2 {
 status = "okay";
};

&ehrpwm2 {
 status = "okay";
 pinctrl-names = "default";
 pinctrl-0 = <&epwmss2_pins>;
};
