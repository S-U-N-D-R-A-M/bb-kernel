# 0 "arch/arm/boot/dts/ti/omap/BB-I2C1-MCP7940X-00A0.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm/boot/dts/ti/omap/BB-I2C1-MCP7940X-00A0.dtso"





/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 1
# 9 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/omap.h" 1
# 10 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 2
# 10 "arch/arm/boot/dts/ti/omap/BB-I2C1-MCP7940X-00A0.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 11 "arch/arm/boot/dts/ti/omap/BB-I2C1-MCP7940X-00A0.dtso" 2




&{/chosen} {
 overlays {
  BB-I2C1-MCP7940X-00A0.kernel = "Tue Jun 16 11:21:58 2026";
 };
};




&ocp {
 P9_17_pinmux { status = "disabled"; };
 P9_18_pinmux { status = "disabled"; };
 P8_26_pinmux { status = "disabled"; };
};

&{/} {
 aliases {
  rtc0 = &extrtc;

  rtc1 = "/ocp/interconnect@44c00000/segment@200000/target-module@3e000/rtc@0";
 };

 gpio_keys {
  compatible = "gpio-keys";
  pinctrl-names = "default";
  pinctrl-0 = <&bb_gpio1_29_pins>;

  rtc_mfp@1 {
   label = "rtc_mfp";
   gpios = <&gpio1 29 0>;
   linux,code = <143>;
   gpio-key,wakeup;
  };
 };
};

&am33xx_pinmux {
 bb_gpio1_29_pins: pinmux_bb_gpio1_29_pins {
  pinctrl-single,pins = <
   ((((0x87c)) & 0xffff) - (0x0800)) (((1 << 5) | (1 << 3))) (7)
  >;
 };

 bb_i2c1_pins: pinmux_bb_i2c1_pins {
  pinctrl-single,pins = <
   ((((0x958)) & 0xffff) - (0x0800)) ((1 << 6) | ((1 << 5) | (1 << 4))) (2)
   ((((0x95c)) & 0xffff) - (0x0800)) ((1 << 6) | ((1 << 5) | (1 << 4))) (2)
  >;
 };
};

&i2c1 {
 status = "okay";
 pinctrl-names = "default";
 pinctrl-0 = <&bb_i2c1_pins>;

 clock-frequency = <100000>;

 #address-cells = <1>;
 #size-cells = <0>;

 extrtc: mcp7940x@68 {
  status = "okay";
  compatible = "microchip,mcp7940x";
  reg = <0x68>;
 };
};
