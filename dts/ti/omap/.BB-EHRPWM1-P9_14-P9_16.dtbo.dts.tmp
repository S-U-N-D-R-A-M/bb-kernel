# 0 "arch/arm/boot/dts/ti/omap/BB-EHRPWM1-P9_14-P9_16.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm/boot/dts/ti/omap/BB-EHRPWM1-P9_14-P9_16.dtso"





/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 1
# 9 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/omap.h" 1
# 10 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 2
# 10 "arch/arm/boot/dts/ti/omap/BB-EHRPWM1-P9_14-P9_16.dtso" 2




&{/chosen} {
 overlays {
  BB-EHRPWM1-P9_14-P9_16.kernel = "Tue Jun 16 11:21:58 2026";
 };
};

&am33xx_pinmux {
 epwmss1_pins: pinmux_epwmss1_pins {
  pinctrl-single,pins = <
   ((((0x848)) & 0xffff) - (0x0800)) (((1 << 3))) (6)
   ((((0x84c)) & 0xffff) - (0x0800)) (((1 << 3))) (6)
  >;
 };
};

&epwmss1 {
 status = "okay";
};

&ehrpwm1 {
 status = "okay";
 pinctrl-names = "default";
 pinctrl-0 = <&epwmss1_pins>;
};
