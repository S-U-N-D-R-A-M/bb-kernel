# 0 "arch/arm/boot/dts/ti/omap/AM3359-PWM012.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm/boot/dts/ti/omap/AM3359-PWM012.dtso"





/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 1
# 9 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/omap.h" 1
# 10 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 2
# 10 "arch/arm/boot/dts/ti/omap/AM3359-PWM012.dtso" 2




&{/chosen} {
 overlays {
  AM3359-PWM012.kernel = "Tue Jun 16 11:21:58 2026";
 };
};


&lcdc {
      status = "disabled";
      };

&mcasp0 {
      status = "disabled";
      };

&am33xx_pinmux {
 nxp_hdmi_bonelt_pins: nxp-hdmi-bonelt-pins {
 };

 nxp_hdmi_bonelt_off_pins: nxp-hdmi-bonelt-off-pins {
 };

 mcasp0_pins: mcasp0-pins {
 };

 epwmss0_pins: pinmux_epwmss0_pins {
  pinctrl-single,pins = <
   ((((0x990)) & 0xffff) - (0x0800)) (((1 << 3)) | 1) (0)
   ((((0x994)) & 0xffff) - (0x0800)) (((1 << 3)) | 1) (0)
  >;
 };

 epwmss1_pins: pinmux_epwmss1_pins {
  pinctrl-single,pins = <
   ((((0x8c8)) & 0xffff) - (0x0800)) (((1 << 3)) | 2) (0)
   ((((0x8cc)) & 0xffff) - (0x0800)) (((1 << 3)) | 2) (0)
  >;
 };

 epwmss2_pins: pinmux_epwmss2_pins {
  pinctrl-single,pins = <
   ((((0x8a0)) & 0xffff) - (0x0800)) (((1 << 3)) | 3) (0)
   ((((0x8a4)) & 0xffff) - (0x0800)) (((1 << 3)) | 3) (0)
  >;
 };
};

&epwmss0 {
 status = "okay";
};

&ehrpwm0 {
 status = "okay";
 pinctrl-names = "default";
 pinctrl-0 = <&epwmss0_pins>;
};

&epwmss1 {
 status = "okay";
};

&ehrpwm1 {
 status = "okay";
 pinctrl-names = "default";
 pinctrl-0 = <&epwmss1_pins>;
};

&epwmss2 {
 status = "okay";
};

&ehrpwm2 {
 status = "okay";
 pinctrl-names = "default";
 pinctrl-0 = <&epwmss2_pins>;
};
