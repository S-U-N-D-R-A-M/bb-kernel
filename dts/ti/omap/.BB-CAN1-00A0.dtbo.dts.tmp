# 0 "arch/arm/boot/dts/ti/omap/BB-CAN1-00A0.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm/boot/dts/ti/omap/BB-CAN1-00A0.dtso"







/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 12 "arch/arm/boot/dts/ti/omap/BB-CAN1-00A0.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 1
# 9 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/omap.h" 1
# 10 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/am33xx.h" 2
# 13 "arch/arm/boot/dts/ti/omap/BB-CAN1-00A0.dtso" 2




&{/chosen} {
 overlays {
  BB-CAN1-00A0.kernel = "Tue Jun 16 11:21:58 2026";
 };
};




&ocp {
 P9_24_pinmux { status = "disabled"; };
 P9_26_pinmux { status = "disabled"; };
};

&am33xx_pinmux {
 bb_dcan1_pins: pinmux_dcan1_pins {
  pinctrl-single,pins = <
   ((((0x984)) & 0xffff) - (0x0800)) (((1 << 5) | (1 << 4))) (2)
   ((((0x980)) & 0xffff) - (0x0800)) (((1 << 4))) (2)
  >;
 };
};

&dcan1 {
 status = "okay";
 pinctrl-names = "default";
 pinctrl-0 = <&bb_dcan1_pins>;
};
